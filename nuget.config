<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin package restore to nuget.org only. Isolates the repo from any machine-global package
    sources (e.g. a stray Azure DevOps feed), which this project does not depend on and which may be
    unreachable during local/agentic development. Also stops NuGet's vulnerability audit from failing
    to load an unreachable feed's index (NU1900). CI restores from nuget.org as well.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
